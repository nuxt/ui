  <div data-slot="leading" class="relative flex items-center justify-center shrink-0 aspect-square overflow-hidden rounded-lg bg-elevated text-muted w-10"><span class="iconify i-lucide:loader-circle shrink-0 size-5 animate-spin" aria-hidden="true" data-slot="leadingIcon"></span></div>
  <div data-slot="wrapper" class="grid grid-cols-[minmax(0,1fr)_auto] items-center min-w-0 flex-1"><span style="--spread: 20px; --duration: 2s;" data-slot="name" class="bg-clip-text bg-no-repeat bg-size-[calc(200%+var(--spread)*2+2px)_100%,auto] bg-[image:linear-gradient(90deg,#0000_calc(50%-var(--spread)),var(--ui-text-highlighted),#0000_calc(50%+var(--spread))),linear-gradient(var(--ui-text-muted),var(--ui-text-muted))] motion-safe:animate-[shimmer_var(--duration)_linear_infinite] motion-safe:rtl:animate-[shimmer-rtl_var(--duration)_linear_infinite] will-change-[background-position] motion-reduce:bg-none motion-reduce:text-muted block truncate font-medium text-highlighted">report.pdf</span><span data-slot="description" class="block truncate row-start-2 text-xs text-muted mt-0.5">PDF</span>
    <!--v-if-->
  </div><span style="position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); clip-path: inset(50%); white-space: nowrap; word-wrap: normal; top: -1px; left: -1px;" aria-live="polite">Uploading</span>
</div>"
`;

exports[`ChatAttachment > renders with ui correctly 1`] = `
"<div data-status="idle" data-orientation="horizontal" data-slot="root" class="group/attachment relative flex max-w-full w-fit shrink-0 rounded-xl border border-default bg-default gap-2.5 p-2 text-sm data-[orientation=vertical]:w-30 items-center min-w-40 pe-2.5">
  <div data-slot="leading" class="relative flex items-center justify-center shrink-0 aspect-square overflow-hidden rounded-lg bg-elevated text-muted w-10"><span class="iconify i-lucide:file shrink-0 size-5" aria-hidden="true" data-slot="leadingIcon"></span></div>
  <div data-slot="wrapper" class="grid grid-cols-[minmax(0,1fr)_auto] items-center min-w-0 flex-1"><span data-slot="name" class="block truncate text-highlighted font-medium">report.pdf</span><span data-slot="description" class="block truncate row-start-2 text-xs text-muted mt-0.5">PDF</span>
    <!--v-if-->
  </div><span style="position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); clip-path: inset(50%); white-space: nowrap; word-wrap: normal; top: -1px; left: -1px;" aria-live="polite"></span>
</div>"
`;
