// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChatMessages > renders with assistant correctly 1`] = `
"<div role="log" data-slot="chat-messages" class="w-full flex flex-col gap-1 flex-1 px-2.5 [&amp;>article]:last-of-type:min-h-(--last-message-height)" style="--last-message-height: 0px;">
  <!---->
  <article data-role="user" data-slot="chat-message" class="group/message relative w-full [--ui-accent:var(--ui-neutral)] scroll-mt-4 sm:scroll-mt-6">
    <!--v-if-->
    <div data-slot="chat-message-container" class="relative flex items-start justify-end ms-auto max-w-[75%] gap-3 pb-8">
      <!--v-if-->
      <div data-slot="chat-message-body" class="min-w-0">
        <div data-slot="chat-message-content" class="relative text-pretty wrap-break-word *:first:mt-0 *:last:mb-0 bg-accent-soft text-accent-default space-y-4 px-4 py-3 rounded-lg min-h-12"><span data-slot="chat-message-text" class="whitespace-pre-wrap">Hello, how are you?</span></div>
        <!--v-if-->
      </div>
    </div>
  </article>
  <article data-role="assistant" data-slot="chat-message" class="group/message relative w-full [--ui-accent:var(--ui-neutral)] scroll-mt-4 sm:scroll-mt-6">
    <!--v-if-->
    <div data-slot="chat-message-container" class="relative flex items-start gap-3 pb-8">
      <div data-slot="chat-message-leading" class="inline-flex items-center justify-center min-h-6"><span data-slot="chat-message-leadingAvatar" class="inline-flex items-center justify-center select-none rounded-full align-middle bg-accent-soft [--ui-accent:var(--ui-neutral)] size-8 text-base shrink-0"><span class="iconify i-lucide:bot shrink-0 text-accent-muted" aria-hidden="true" data-slot="avatar-icon"></span></span></div>
      <div data-slot="chat-message-body" class="min-w-0 w-full">
        <div data-slot="chat-message-content" class="relative text-pretty wrap-break-word *:first:mt-0 *:last:mb-0 text-accent-default space-y-4 w-full"><span data-slot="chat-message-text" class="whitespace-pre-wrap">I am fine, thank you!</span></div>
        <!--v-if-->
      </div>
    </div>
  </article>
  <!--v-if-->
  <!---->
</div>"
`;

