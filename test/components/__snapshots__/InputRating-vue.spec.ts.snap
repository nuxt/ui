    <!--v-if--><button data-reka-collection-item="" tabindex="-1" data-orientation="horizontal" aria-label="Rate 5 stars out of 5" class="absolute inset-0 focus:outline-none w-full" role="radio" type="button" aria-checked="false" data-state="unchecked" required="false" value="5">
