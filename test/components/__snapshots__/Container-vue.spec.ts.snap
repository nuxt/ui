// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Container > renders with as correctly 1`] = `"<article data-slot="container" class="w-full max-w-(--ui-container) mx-auto px-(--ui-gutter)"></article>"`;

exports[`Container > renders with class correctly 1`] = `"<div data-slot="container" class="w-full mx-auto px-(--ui-gutter) max-w-5xl"></div>"`;

exports[`Container > renders with default slot correctly 1`] = `"<div data-slot="container" class="w-full max-w-(--ui-container) mx-auto px-(--ui-gutter)">Default slot</div>"`;
