  <div data-slot="checkbox-container" class="flex items-center h-5"><button data-slot="checkbox-base" class="rounded-sm ring ring-inset ring-accented overflow-hidden size-4 outline-accent-focus focus-visible:outline-solid focus-visible:outline-3 focus-visible:ring-accent" id="v-0" role="checkbox" type="button" aria-checked="false" aria-required="true" data-state="unchecked">
      <!---->
    </button>
    <!--v-if-->
  </div>
  <div data-slot="checkbox-wrapper" class="w-full ms-2 text-sm">
    <!--v-if--><label for="v-0" data-slot="checkbox-label" class="block font-medium text-default after:content-['*'] after:ms-0.5 after:text-error">Label</label>
    <!--v-if-->
  </div>
</div>"
`;

