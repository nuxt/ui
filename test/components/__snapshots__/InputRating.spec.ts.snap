exports[`InputRating > renders with as correctly 1`] = `
"<span data-slot="input-rating" class="inline-flex items-center gap-0.5" tabindex="0" data-orientation="horizontal" dir="ltr" style="outline-color: none; outline-style: none; outline-width: initial;" role="radiogroup" aria-orientation="horizontal" aria-required="false"><label data-slot="input-rating-item" class="relative inline-block cursor-pointer select-none rounded-sm has-focus-visible:outline-3 transition outline-accent-focus size-5 [--ui-accent:var(--ui-primary)] hover:scale-110"><!-- Empty icon as background --><span class="iconify i-lucide:star block w-full h-full text-muted pointer-events-none" aria-hidden="true" data-slot="input-rating-emptyIcon"></span><!-- Indicators overlaid for each step, clipped to the rated fraction --><button role="radio" type="button" aria-checked="false" aria-label="Rate 1 out of 5" data-state="active" required="false" data-reka-collection-item="" tabindex="-1" data-orientation="horizontal" style="--reka-rating-item-step-width: 100%; --reka-rating-item-step-opacity: 1; --reka-rating-item-step-z-index: 1;" data-slot="input-rating-indicator" class="absolute inset-0 overflow-hidden outline-none text-transparent w-(--reka-rating-item-step-width) opacity-(--reka-rating-item-step-opacity) z-(--reka-rating-item-step-z-index) data-[state=active]:text-accent [--ui-accent:var(--ui-primary)]" value="1"><span class="iconify i-lucide:star block size-5" aria-hidden="true" data-state="unchecked" data-slot="input-rating-icon"></span></button>
