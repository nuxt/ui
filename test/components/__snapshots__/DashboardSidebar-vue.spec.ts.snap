  <div data-dismissable-layer="" style="pointer-events: auto;" tabindex="-1" id="reka-dialog-v-0-0-content" data-side="left" data-slot="slideover-content" class="fixed bg-overlay divide-y divide-default sm:ring ring-default sm:shadow-lg flex flex-col focus:outline-none sm:max-w-md w-full inset-y-0 left-0 data-[state=open]:animate-[slide-in-from-left_200ms_var(--ease-out)] data-[state=closed]:animate-[slide-out-to-left_200ms_var(--ease-out)] lg:hidden" data-state="open" role="dialog" aria-describedby="reka-dialog-v-0-0-description" aria-labelledby="reka-dialog-v-0-0-title"><span style="position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); clip-path: inset(50%); white-space: nowrap; word-wrap: normal; top: -1px; left: -1px;"><h2 id="reka-dialog-v-0-0-title">Open sidebar</h2><p id="reka-dialog-v-0-0-description"></p></span>
    <div data-slot="dashboard-sidebar-header" class="h-(--ui-header-height) shrink-0 flex items-center gap-1.5 px-4 sm:px-6">
      <!--v-if--><button type="button" data-slot="dashboard-sidebar-toggle" aria-label="Close sidebar" class="rounded-md font-medium inline-flex items-center disabled:cursor-not-allowed aria-disabled:cursor-not-allowed disabled:opacity-(--ui-disabled-opacity) aria-disabled:opacity-(--ui-disabled-opacity) transition-colors outline-accent-focus focus-visible:outline-(length:--ui-focus-width) [--ui-accent:var(--ui-neutral)] text-accent-default hover:bg-accent-soft active:bg-accent-soft disabled:bg-transparent aria-disabled:bg-transparent [--ui-control-px:var(--ui-control-px-md)] [--ui-control-py:var(--ui-control-py-md)] [--ui-control-gap:var(--ui-control-gap-md)] [--ui-control-icon-size:var(--ui-control-icon-size-md)] py-(--ui-control-py) gap-(--ui-control-gap) text-(length:--ui-control-text-md)/(--ui-control-text-md--line-height) px-(--ui-control-py) lg:hidden ms-auto"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" height="1em" viewBox="0 0 16 16" data-slot="button-leadingIcon" class="shrink-0 size-(--ui-control-icon-size)"></svg>
        <!--v-if-->
        <!--v-if-->
      </button>
    </div>
    <div data-slot="dashboard-sidebar-body" class="flex flex-col gap-4 flex-1 overflow-y-auto px-4 py-2 sm:px-6"></div>
    <!--v-if-->
  </div>
  <!--teleport end-->
</div>"
`;

