      <div data-slot="leading" class="flex items-center justify-center shrink-0 aspect-square rounded-md bg-elevated text-muted size-10"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" height="1em" viewBox="0 0 16 16" data-slot="leadingIcon" class="shrink-0 size-5"></svg></div>
