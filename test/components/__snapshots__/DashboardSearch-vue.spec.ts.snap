exports[`DashboardSearch > renders with class correctly 1`] = `
"<div data-slot="dashboard-group" class="fixed inset-0 flex overflow-hidden">
  <!---->
  <!--v-if-->
  <!--teleport start-->
  <div data-state="open" style="pointer-events: auto;" data-slot="modal-overlay" class="fixed inset-0 data-[state=open]:animate-[fade-in_200ms_var(--ease-out)] data-[state=closed]:animate-[fade-out_200ms_var(--ease-out)] bg-backdrop"></div>
  <div data-dismissable-layer="" style="pointer-events: auto;" tabindex="-1" data-slot="modal-content" class="bg-default divide-y divide-default flex flex-col focus:outline-none data-[state=open]:animate-[scale-in_200ms_var(--ease-out)] data-[state=closed]:animate-[scale-out_200ms_var(--ease-out)] w-[calc(100vw-2rem)] max-w-lg rounded-lg shadow-lg ring ring-default fixed top-1/2 left-1/2 -translate-1/2 max-h-[calc(100dvh-2rem)] sm:max-h-[calc(100dvh-4rem)] overflow-hidden h-full sm:h-112 sm:max-w-5xl" id="" role="dialog" aria-describedby="reka-dialog-description-v-0-1" aria-labelledby="reka-dialog-title-v-0-0" data-state="open"><span style="position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); clip-path: inset(50%); white-space: nowrap; word-wrap: normal; top: -1px; left: -1px;"><h2 id="reka-dialog-title-v-0-0">Search…</h2><p id="reka-dialog-description-v-0-1"></p></span>
    <!---->
    <div dir="ltr" data-slot="command-palette" class="flex flex-col min-h-0 min-w-0 divide-y divide-default">
      <div data-slot="command-palette-input" class="relative inline-flex items-center [--ui-control-px:--spacing(2.5)] [--ui-control-py:--spacing(1.5)] [--ui-control-gap:--spacing(1.5)] [--ui-control-icon:--spacing(5)] [--ui-accent:var(--ui-primary)] [&amp;>input]:h-12"><input type="text" placeholder="Type a command or search…" class="w-full rounded-md border-0 appearance-none text-strong placeholder:text-faint disabled:cursor-not-allowed disabled:opacity-75 transition-colors px-(--ui-control-px) py-(--ui-control-py) gap-(--ui-control-gap) text-base/5 bg-transparent focus:outline-none ps-[calc(var(--ui-control-px)+var(--ui-control-icon)+var(--ui-control-gap))] pe-[calc(var(--ui-control-px)+var(--ui-control-icon)+var(--ui-control-gap))]" autocomplete="off" aria-disabled="false" data-slot="input-base" value="" aria-activedescendant="reka-listbox-item-v-0-0-1"><span data-slot="input-leading" class="absolute inset-y-0 inset-s-0 flex items-center ps-(--ui-control-px)"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" height="1em" viewBox="0 0 16 16" data-slot="input-leadingIcon" class="shrink-0 text-faint size-(--ui-control-icon)"></svg></span><span data-slot="input-trailing" class="absolute inset-y-0 inset-e-0 flex items-center pe-(--ui-control-px)"><button type="button" data-slot="command-palette-close" aria-label="Close" class="rounded-md font-medium inline-flex items-center disabled:cursor-not-allowed aria-disabled:cursor-not-allowed disabled:opacity-75 aria-disabled:opacity-75 transition-colors outline-accent-focus focus-visible:outline-3 [--ui-accent:var(--ui-neutral)] text-accent-default hover:bg-accent-soft active:bg-accent-soft disabled:bg-transparent aria-disabled:bg-transparent [--ui-control-px:--spacing(2.5)] [--ui-control-py:--spacing(1.5)] [--ui-control-gap:--spacing(1.5)] [--ui-control-icon:--spacing(5)] py-(--ui-control-py) gap-(--ui-control-gap) text-sm px-(--ui-control-py)"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" height="1em" viewBox="0 0 16 16" data-slot="button-leadingIcon" class="shrink-0 size-(--ui-control-icon)"></svg><!--v-if--><!--v-if--></button></span></div>
      <div data-slot="command-palette-content" class="relative overflow-hidden flex flex-col" role="listbox" tabindex="-1" aria-orientation="vertical" aria-multiselectable="false" data-orientation="vertical">
        <div role="presentation" data-slot="command-palette-viewport" class="relative scroll-py-1 overflow-y-auto flex-1 focus:outline-none divide-y divide-default">
          <div role="group" aria-labelledby="reka-listbox-group-v-0-0-0" data-slot="command-palette-group" class="p-1 isolate">
            <div id="reka-listbox-group-v-0-0-0" data-slot="command-palette-label" class="font-semibold text-strong p-1.5 text-xs gap-1.5">Go to</div><a href="/" role="option" tabindex="-1" data-reka-collection-item="" id="reka-listbox-item-v-0-0-1" aria-selected="false" data-state="unchecked" data-slot="command-palette-item" class="group relative w-full flex items-start select-none outline-none before:absolute before:z-[-1] before:inset-px before:rounded-md data-disabled:cursor-not-allowed data-disabled:opacity-75 p-1.5 text-sm gap-1.5 text-strong before:bg-soft" data-highlighted="">
              <!--v-if--><span data-slot="command-palette-itemWrapper" class="flex-1 flex flex-col text-start min-w-0"><span data-slot="command-palette-itemLabel" class="truncate space-x-1 text-faint"><!--v-if--><span data-slot="command-palette-itemLabelBase" class="text-strong [&amp;>mark]:text-primary-default [&amp;>mark]:bg-primary/15">Home</span>
              <!--v-if--></span>
              <!--v-if--></span><span data-slot="command-palette-itemTrailing" class="ms-auto inline-flex items-center gap-1.5"><!--v-if--><!----></span>
            </a>
          </div>
          <div role="group" aria-labelledby="reka-listbox-group-v-0-0-2" data-slot="command-palette-group" class="p-1 isolate">
            <div id="reka-listbox-group-v-0-0-2" data-slot="command-palette-label" class="font-semibold text-strong p-1.5 text-xs gap-1.5">Theme</div><button type="button" data-reka-collection-item="" id="reka-listbox-item-v-0-0-3" role="option" tabindex="-1" aria-selected="false" data-state="unchecked" data-slot="command-palette-item" class="group relative w-full flex items-start select-none outline-none before:absolute before:z-[-1] before:inset-px before:rounded-md data-disabled:cursor-not-allowed data-disabled:opacity-75 p-1.5 text-sm gap-1.5 text-strong before:bg-soft"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" height="1em" viewBox="0 0 16 16" data-slot="command-palette-itemLeadingIcon" class="shrink-0 size-5 text-default"></svg><span data-slot="command-palette-itemWrapper" class="flex-1 flex flex-col text-start min-w-0"><span data-slot="command-palette-itemLabel" class="truncate space-x-1 text-faint"><!--v-if--><span data-slot="command-palette-itemLabelBase" class="text-strong [&amp;>mark]:text-primary-default [&amp;>mark]:bg-primary/15">System</span>
              <!--v-if--></span>
              <!--v-if--></span><span data-slot="command-palette-itemTrailing" class="ms-auto inline-flex items-center gap-1.5"><!--v-if--><!----></span>
            </button><button type="button" data-reka-collection-item="" id="reka-listbox-item-v-0-0-4" role="option" tabindex="-1" aria-selected="false" data-state="unchecked" data-slot="command-palette-item" class="group relative w-full flex items-start select-none outline-none before:absolute before:z-[-1] before:inset-px before:rounded-md data-disabled:cursor-not-allowed data-disabled:opacity-75 p-1.5 text-sm gap-1.5 text-default data-highlighted:not-data-disabled:text-strong data-highlighted:not-data-disabled:before:bg-tint transition-colors before:transition-colors"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" height="1em" viewBox="0 0 16 16" data-slot="command-palette-itemLeadingIcon" class="shrink-0 size-5 text-faint group-data-highlighted:not-group-data-disabled:text-default transition-colors"></svg><span data-slot="command-palette-itemWrapper" class="flex-1 flex flex-col text-start min-w-0"><span data-slot="command-palette-itemLabel" class="truncate space-x-1 text-faint"><!--v-if--><span data-slot="command-palette-itemLabelBase" class="text-strong [&amp;>mark]:text-primary-default [&amp;>mark]:bg-primary/15">Light</span>
              <!--v-if--></span>
              <!--v-if--></span><span data-slot="command-palette-itemTrailing" class="ms-auto inline-flex items-center gap-1.5"><!--v-if--><!----></span>
            </button><button type="button" data-reka-collection-item="" id="reka-listbox-item-v-0-0-5" role="option" tabindex="-1" aria-selected="false" data-state="unchecked" data-slot="command-palette-item" class="group relative w-full flex items-start select-none outline-none before:absolute before:z-[-1] before:inset-px before:rounded-md data-disabled:cursor-not-allowed data-disabled:opacity-75 p-1.5 text-sm gap-1.5 text-default data-highlighted:not-data-disabled:text-strong data-highlighted:not-data-disabled:before:bg-tint transition-colors before:transition-colors"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" height="1em" viewBox="0 0 16 16" data-slot="command-palette-itemLeadingIcon" class="shrink-0 size-5 text-faint group-data-highlighted:not-group-data-disabled:text-default transition-colors"></svg><span data-slot="command-palette-itemWrapper" class="flex-1 flex flex-col text-start min-w-0"><span data-slot="command-palette-itemLabel" class="truncate space-x-1 text-faint"><!--v-if--><span data-slot="command-palette-itemLabelBase" class="text-strong [&amp;>mark]:text-primary-default [&amp;>mark]:bg-primary/15">Dark</span>
