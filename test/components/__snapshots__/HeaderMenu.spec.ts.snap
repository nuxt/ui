    <div data-slot="slideover-actions" class="flex items-center gap-1.5 shrink-0 ms-auto min-h-lh group-has-[>[data-slot$=-wrapper]>[data-slot$=-description]]/header:self-start"><button type="button" data-slot="slideover-close" aria-label="Close" class="rounded-md font-medium inline-flex items-center disabled:cursor-not-allowed aria-disabled:cursor-not-allowed disabled:opacity-(--ui-disabled-opacity) aria-disabled:opacity-(--ui-disabled-opacity) transition-colors outline-accent-focus focus-visible:outline-(length:--ui-focus-width) [--ui-accent:var(--ui-neutral)] text-accent-default hover:bg-accent-soft active:bg-accent-soft disabled:bg-transparent aria-disabled:bg-transparent [--ui-control-px:var(--ui-control-px-xs)] [--ui-control-py:var(--ui-control-py-xs)] [--ui-control-gap:var(--ui-control-gap-xs)] [--ui-control-icon-size:var(--ui-control-icon-size-xs)] py-(--ui-control-py) gap-(--ui-control-gap) text-(length:--ui-control-text-xs)/(--ui-control-text-xs--line-height) px-(--ui-control-py) -my-(--ui-control-py) -me-(--ui-control-py)"><span class="iconify i-lucide:x shrink-0 size-(--ui-control-icon-size)" aria-hidden="true" data-slot="button-leadingIcon"></span>
        <!--v-if-->
        <!--v-if-->
      </button></div>
  </div>
  <div data-slot="slideover-body" class="flex-1 p-(--ui-gutter) overflow-y-auto">Default slot</div>
  <!--v-if-->
</div>



<!--teleport end-->"
`;

exports[`HeaderMenu > renders with ui correctly 1`] = `
"<!-- The menu is a non-modal dialog: the header stays usable while it's open -->
<header data-slot="header" class="bg-default/75 backdrop-blur-sm border-b border-default h-(--ui-header-height) sticky top-0 z-50">
  <div data-slot="header-container" class="w-full max-w-(--ui-container-width) mx-auto px-(--ui-gutter) flex items-center justify-between gap-3 h-full">
    <div data-slot="header-left" class="lg:flex-1 flex items-center gap-1.5">
      <!--v-if--><a href="/" data-slot="header-title" aria-label="Nuxt UI" class="outline-focus focus-visible:outline-(length:--ui-focus-width) rounded-md hover:text-default transition-colors shrink-0 font-heading font-(--ui-font-weight-heading,--theme(--font-weight-bold)) text-xl text-strong flex items-end gap-1.5">Nuxt UI</a>
    </div>
    <div data-slot="header-center" class="hidden lg:flex"></div>
    <div data-slot="header-right" class="flex items-center justify-end lg:flex-1 gap-1.5">Right slot<button type="button" data-slot="header-toggle" aria-haspopup="dialog" aria-expanded="true" aria-controls="reka-dialog-content-v-0-0-0" data-state="open" aria-label="Close menu" class="rounded-md font-medium inline-flex items-center disabled:cursor-not-allowed aria-disabled:cursor-not-allowed disabled:opacity-(--ui-disabled-opacity) aria-disabled:opacity-(--ui-disabled-opacity) transition-colors outline-accent-focus focus-visible:outline-(length:--ui-focus-width) [--ui-accent:var(--ui-neutral)] text-accent-default hover:bg-accent-soft active:bg-accent-soft disabled:bg-transparent aria-disabled:bg-transparent [--ui-control-px:var(--ui-control-px-md)] [--ui-control-py:var(--ui-control-py-md)] [--ui-control-gap:var(--ui-control-gap-md)] [--ui-control-icon-size:var(--ui-control-icon-size-md)] py-(--ui-control-py) gap-(--ui-control-gap) text-(length:--ui-control-text-md)/(--ui-control-text-md--line-height) px-(--ui-control-py) lg:hidden -me-1.5"><span class="iconify i-lucide:x shrink-0 size-(--ui-control-icon-size)" aria-hidden="true" data-slot="button-leadingIcon"></span>
        <!--v-if-->
        <!--v-if-->
      </button></div>
  </div>
</header>
<div data-dismissable-layer="" tabindex="-1" data-slot="header-menu" class="fixed inset-x-0 bottom-0 top-(--ui-header-height) z-40 flex flex-col bg-overlay lg:hidden" id="reka-dialog-content-v-0-0-0" role="dialog" aria-describedby="reka-dialog-description-v-0-0-1-1" aria-labelledby="reka-dialog-title-v-0-0-1-0" data-state="open"><span style="position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); clip-path: inset(50%); white-space: nowrap; word-wrap: normal; top: -1px; left: -1px;"><h2 id="reka-dialog-title-v-0-0-1-0">Open menu</h2><p id="reka-dialog-description-v-0-0-1-1"></p></span>
  <div data-slot="header-menu-body" class="flex-1 overflow-y-auto p-6">Default slot</div>
</div>"
`;
