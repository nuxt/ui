      </button></div>
  </div>
</header>
<div data-dismissable-layer="" tabindex="-1" data-slot="header-menu" class="fixed inset-x-0 bottom-0 top-(--ui-header-height) z-40 flex flex-col lg:hidden bg-default" id="reka-dialog-content-v-0-0-0" role="dialog" aria-describedby="reka-dialog-description-v-0-0-1-1" aria-labelledby="reka-dialog-title-v-0-0-1-0" data-state="open"><span style="position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); clip-path: inset(50%); white-space: nowrap; word-wrap: normal; top: -1px; left: -1px;"><h2 id="reka-dialog-title-v-0-0-1-0">Open menu</h2><p id="reka-dialog-description-v-0-0-1-1"></p></span>
  <div data-slot="header-menu-body" class="flex-1 p-(--ui-gutter) overflow-y-auto">Default slot</div>
</div>"
`;

