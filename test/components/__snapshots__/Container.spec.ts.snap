// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Container > renders with as correctly 1`] = `"<article data-slot="container" class="w-full max-w-(--ui-container) mx-auto px-4 sm:px-6 lg:px-8"></article>"`;

exports[`Container > renders with class correctly 1`] = `"<div data-slot="container" class="w-full mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl"></div>"`;

exports[`Container > renders with default slot correctly 1`] = `"<div data-slot="container" class="w-full max-w-(--ui-container) mx-auto px-4 sm:px-6 lg:px-8">Default slot</div>"`;
