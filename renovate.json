{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nuxt/renovate-config-nuxt"
  ],
  "baseBranchPatterns": [
    "v5"
  ],
  "packageRules": [
    {
      "groupName": "reka-ui",
      "matchPackageNames": [
        "reka-ui"
      ]
    },
    {
      "groupName": "tiptap",
      "matchPackageNames": [
        "@tiptap/*"
      ]
    },
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "enabled": false
    }
  ]
}
